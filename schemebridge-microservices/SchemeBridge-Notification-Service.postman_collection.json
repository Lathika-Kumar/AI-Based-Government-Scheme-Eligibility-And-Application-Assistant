              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "preferences"]
            }
          }
        },
        {
          "name": "2. Update Notification Preferences",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailEnabled\": true,\n  \"smsEnabled\": true,\n  \"pushEnabled\": false,\n  \"inAppEnabled\": true,\n  \"marketingNotifications\": false,\n  \"schemeAlerts\": true,\n  \"applicationUpdates\": true,\n  \"documentReminders\": true,\n  \"otpMessages\": true,\n  \"languagePreference\": \"hi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "preferences"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Gateway & Service Info APIs",
      "item": [
        {
          "name": "1. Get Service Info (Direct Port 8086)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service/info",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service", "info"]
            }
          }
        },
        {
          "name": "2. Get Service Info (Via API Gateway 8080)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/notifications/my",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "notifications", "my"]
            }
          }
        }
      ]
    }
  ]
}
