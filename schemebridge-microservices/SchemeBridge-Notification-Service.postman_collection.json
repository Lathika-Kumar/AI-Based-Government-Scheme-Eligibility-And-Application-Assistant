            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "{{notificationId}}", "read"]
            }
          }
        },
        {
          "name": "5. Mark Notification as UNREAD",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/unread",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "{{notificationId}}", "unread"]
            }
          }
        },
        {
          "name": "6. Mark All Notifications as READ",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "read-all"]
            }
          }
        },
        {
          "name": "7. Search Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/search?q=Application",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "search"],
              "query": [
                { "key": "q", "value": "Application" }
              ]
            }
          }
        },
        {
          "name": "8. Get Notification History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/history?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "history"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "9. Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "dashboard"]
            }
          }
        },
        {
          "name": "10. Delete Notification Item",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/{{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "{{notificationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Notification Preference APIs",
      "item": [
