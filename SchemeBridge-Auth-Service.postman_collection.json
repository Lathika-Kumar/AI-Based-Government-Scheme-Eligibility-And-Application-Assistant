          "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"otpCode\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/verify-phone-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "verify-phone-otp"
          ]
        }
      }
    },
    {
      "name": "9. Forgot Password",
      "request": {
