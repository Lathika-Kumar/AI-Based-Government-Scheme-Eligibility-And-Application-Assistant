            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"citizen.test@schemebridge.gov.in\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}"
        },
