# ═════════════════════════════════════════════════════════════════════════════
# SchemeBridge Environment Variables Template (.env.example)
# Copy this file to .env and provide your local/production credentials.
# NEVER commit .env with real credentials to version control.
# ═════════════════════════════════════════════════════════════════════════════

# Application Ports & Security
PORT=8080
JWT_SECRET=your-minimum-32-character-secret-key-here
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Database Configuration: Oracle 21c XE (Auth Service)
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=SYSTEM
ORACLE_PASSWORD=system

# Database Configuration: MongoDB 7.0 (Scheme Service)
MONGODB_URI=mongodb://schemebridge_user:31Rfp1OuAafIzBhm1Xu6G5p7@localhost:27017/schemebridge_scheme_db?authSource=admin

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# Development / Testing OTP Mode
# Set to true to print generated 6-digit OTPs directly into server terminal logs:
OTP_LOG_RAW_VALUE=true

# Option A: Outbound Email Configuration via SMTP (e.g., Gmail)
# Requires a 16-character Google App Password (not your personal password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
SPRING_MAIL_FROM=noreply@schemebridge.gov.in
SPRING_MAIL_FROM_NAME=SchemeBridge Portal

# Option B: Outbound Email Configuration via Brevo REST API
BREVO_EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SchemeBridge
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email
