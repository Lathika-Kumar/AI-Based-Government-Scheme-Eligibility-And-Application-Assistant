# Auth Service base URL (Spring Boot on port 8080)
VITE_AUTH_API_URL=http://localhost:8080

# Scheme Service base URL (Spring Boot on port 8081)
VITE_SCHEME_API_URL=http://localhost:8081

# Set to true to force all services into mock mode (for isolated UI development)
VITE_USE_MOCK_API=false

# Application environment label
VITE_ENVIRONMENT=development

# Max upload file size in bytes (5 MB)
VITE_MAX_FILE_SIZE=5242880

# Temporary UI Flow Testing Flag (Must be false in production)
VITE_FRONTEND_FLOW_TEST_MODE=false

