# Oracle Database Configuration
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=SYSTEM
ORACLE_PASSWORD=system

# JWT Configuration
# The secret must be a base64-encoded string or a plain string of at least 256 bits (32 characters)
JWT_SECRET=9a4f2c8d3e7b1a5c6d8e7f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c
JWT_EXPIRATION=3600000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OTP Configuration (Set to true only in development/testing environments; false in production)
OTP_LOG_RAW_VALUE=false

# SMTP Mail Server Configuration (Real email delivery)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
# Brevo Transactional Email Configuration
BREVO_EMAIL_ENABLED=false
BREVO_API_KEY=<YOUR_BREVO_API_KEY>
BREVO_SENDER_EMAIL=noreply@schemebridge.gov.in
BREVO_SENDER_NAME=SchemeBridge
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email

