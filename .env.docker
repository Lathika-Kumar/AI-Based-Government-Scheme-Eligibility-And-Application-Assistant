# ═════════════════════════════════════════════════════════════════════════════
# SchemeBridge Production Docker Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════

# Port on host machine where the application will be accessible (defaults to 80)
PORT=80

# Security: JWT Signing Secret (must match across Auth & Scheme services)
JWT_SECRET=LRCXhnioMtYNNZMrgfKfabTER44FEVNKiB9RVMuO1tE=
JWT_EXPIRATION=3600000

# MongoDB Configuration (Internal Docker Network)
MONGO_ROOT_USER=schemebridge_user
MONGO_ROOT_PASSWORD=31Rfp1OuAafIzBhm1Xu6G5p7
MONGO_DB_NAME=schemebridge_scheme_db

# Oracle Database Configuration (Auth Service)
# If using an Oracle database running on the host machine:
ORACLE_URL=jdbc:oracle:thin:@host.docker.internal:1521/XEPDB1
# If using an external/cloud Oracle DB:
# ORACLE_URL=jdbc:oracle:thin:@your-oracle-host:1521/your-service-name
ORACLE_USERNAME=SYSTEM
ORACLE_PASSWORD=system

# Frontend URL & CORS
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# SMTP / Mail Settings (Optional, for production citizen email notifications)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
